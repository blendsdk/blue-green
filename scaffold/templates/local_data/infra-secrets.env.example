# =============================================================================
# Infrastructure Secrets — {{PROJECT_NAME}}
# =============================================================================
# Copy this file to `infra-secrets.env`, fill in real values, then push to
# GitHub Secrets:
#
#   cp local_data/infra-secrets.env.example local_data/infra-secrets.env
#   ./scripts/push-infra-secrets.sh --dry-run   # preview
#   ./scripts/push-infra-secrets.sh             # push for real
#
# Format: one KEY=VALUE per line. Comments (#) and blank lines are ignored.
# The `@path` prefix reads the value from a file (used for the SSH key, which
# is multiline and must never be inlined).
#
# This file (infra-secrets.env) lives under local_data/ and is GITIGNORED —
# it never gets committed. Only this .example template is safe to commit.
# =============================================================================

# SSH private key for deployment (read from a file via the @ prefix).
# Generate a dedicated deploy key, then add deploy_key.pub to each server's
# ~/.ssh/authorized_keys:
#   ssh-keygen -t ed25519 -C "deploy@{{PROJECT_NAME_LOWER}}" -f deploy_key -N ""
SSH_PRIVATE_KEY=@deploy_key

# Base deployment path on the remote servers (must be an absolute path).
DEPLOY_PATH=/opt/deployments

# Host addresses — resolved into deploy-inventory.json's ${VAR} placeholders
# at deploy time, keeping real server addresses out of git.
TEST_HOST=10.0.1.30
ACC_HOST=10.0.2.10
PROD_HOST=10.0.3.10

# Jump host for SSH proxying (uncomment if any environment uses jump_host access)
# JUMP_HOST=user@bastion.example.com

# Docker registry credentials (uncomment for the registry deployment strategy)
# REGISTRY_USER=ci-deployer
# REGISTRY_PASSWORD=change-me
