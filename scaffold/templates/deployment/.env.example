# =============================================================================
# {{PROJECT_NAME}} — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to git — it contains secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Project
# -----------------------------------------------------------------------------
# Deployment environment (set automatically by CI/CD pipeline).
# Values: development, test, acceptance, production.
# NOTE: this is defined BEFORE COMPOSE_PROJECT_NAME on purpose — Docker Compose
# interpolates .env lines top-to-bottom, so DEPLOY_ENV must already be set for
# the COMPOSE_PROJECT_NAME reference below to pick it up.
DEPLOY_ENV=development

# Docker Compose namespaces ALL resources (containers, networks, volumes) by
# COMPOSE_PROJECT_NAME. On a shared Docker host where multiple environments
# (test/acceptance/production) run side by side, each MUST have a distinct
# project name — otherwise they collide and can share the same volumes/database.
#
# The CI/CD deploy path sets this per environment automatically (the release
# workflow passes --project-name <project>-<deploy_target>). For manual
# `docker compose` runs the suffix is derived from DEPLOY_ENV above so manual
# runs stay isolated too.
COMPOSE_PROJECT_NAME={{PROJECT_NAME_LOWER}}-${DEPLOY_ENV:-development}

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
# Number of app container replicas per color (blue or green)
APP_REPLICAS={{APP_REPLICAS}}

# Which environment is currently receiving traffic: "blue" or "green"
# This is updated automatically by scripts/remote-ops.sh switch-color
ACTIVE_ENV=blue

# -----------------------------------------------------------------------------
# Nginx
# -----------------------------------------------------------------------------
# Port exposed on the host (ProxyBuilder forwards traffic here)
NGINX_HTTP_PORT={{NGINX_PORT}}

# -----------------------------------------------------------------------------
# Health Check Configuration
# -----------------------------------------------------------------------------
# Used by scripts/remote-ops.sh and scripts/health-check-wait.sh
HEALTH_CHECK_RETRIES=5
HEALTH_CHECK_INTERVAL=2

# -----------------------------------------------------------------------------
# Dozzle — Web-based log viewer
# -----------------------------------------------------------------------------
DOZZLE_PORT=9999
DOZZLE_USERNAME=admin
DOZZLE_PASSWORD=changeme_dozzle_password

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
TZ=Europe/Amsterdam

{{ENV_REGISTRY_PARTIAL}}{{ENV_POSTGRES_PARTIAL}}{{ENV_REDIS_PARTIAL}}{{ENV_BACKUP_PARTIAL}}
